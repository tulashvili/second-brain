{
  "name": "@security-maybeso/version-publish",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components.d.ts",
      "import": "./dist/components.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "test": "tsx --test src/*.test.ts*",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@quartz-community/types": "^1.0.0",
    "preact": "^10.28.2"
  },
  "devDependencies": {
    "preact-render-to-string": "^6.6.5",
    "tsup": "^8.5.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10.9.2"
  },
  "quartz": {
    "name": "version-publish",
    "displayName": "Version Publish",
    "category": [
      "filter",
      "component"
    ],
    "version": "1.0.0",
    "quartzVersion": ">=5.0.0",
    "defaultOrder": 10,
    "defaultEnabled": true,
    "defaultOptions": {},
    "optionSchema": {},
    "components": {
      "VersionLabel": {
        "displayName": "Note Version",
        "defaultPosition": "beforeBody",
        "defaultPriority": 25
      }
    }
  }
}
